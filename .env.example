# Optional startup settings: copy to the project root as .env.
# Process environment > .env > built-in defaults. Restart after changes.
# Only the six options below are read; NODE_ENV is controlled by startup scripts.
# Model, search and MCP credentials belong in Settings, not this file.
# Values are literal: no ~, ${VAR} or command expansion.

# Default: ~/.teach-me-coding/. A custom data directory must be an absolute path.
# TMC_DATA_DIR=/absolute/path/to/teach-me-coding-data

# 127.0.0.1 or 0.0.0.0. Network mode has no login; trusted networks only.
HOST=127.0.0.1

# API port; production serves the UI on the same port.
PORT=4310

# Development frontend port; also used by the API's development access checks.
TMC_WEB_PORT=5173

# Optional exact HTTP loopback preview origin; replace the example port.
# Leave commented when unused, rather than setting an empty value.
# TMC_PREVIEW_ORIGIN=http://127.0.0.1:54492

# 1 writes private request snapshots to the data directory's agent-debug/.
# Leave disabled unless debugging; snapshots may contain sensitive content.
TMC_AGENT_DEBUG_SNAPSHOTS=0
