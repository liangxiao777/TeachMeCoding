{
  "name": "teach-me-coding",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": { "node": ">=24.15.0 <25", "pnpm": "11.1.0" },
  "scripts": {
    "dev": "pnpm --filter @teach-me-coding/contracts build && concurrently --kill-others --names server,web \"pnpm --filter @teach-me-coding/server dev\" \"pnpm --filter @teach-me-coding/web dev\"",
    "build": "pnpm -r build",
    "check": "pnpm --filter @teach-me-coding/contracts build && pnpm -r check && tsc -p tests",
    "check:i18n": "node --test tests/i18n.test.mjs",
    "test": "pnpm --filter @teach-me-coding/contracts build && pnpm -r test && node --test \"tests/*.test.mjs\"",
    "test:browser": "playwright test",
    "test:native": "pnpm --filter @teach-me-coding/server exec tsx --test --test-timeout=15000 src/compatibility/native.test.ts",
    "test:provider": "pnpm --filter @teach-me-coding/server exec tsx src/compatibility/provider-smoke.ts",
    "start": "node scripts/server.mjs production"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
