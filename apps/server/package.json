    "@earendil-works/pi-mcp": "1.0.0",
    "@hono/node-server": "2.1.3",
    "@mozilla/readability": "0.6.0",
    "@openai/codex": "0.160.0",
    "@teach-me-coding/contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.12",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "marked": "18.1.0",
    "node-pty": "1.1.0",
    "skills": "1.7.0",
    "turndown": "7.2.4",
    "undici": "8.11.2",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
