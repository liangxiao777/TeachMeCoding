{
  "name": "@teach-me-coding/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/agents/prompts && cp src/agents/prompts/*.xml dist/agents/prompts/",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-timeout=15000 src/**/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-mcp": "1.0.0",
    "@hono/node-server": "2.1.3",
    "@teach-me-coding/contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.12",
    "node-pty": "1.1.0",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1",
    "fast-xml-parser": "5.11.2"
  }
}
