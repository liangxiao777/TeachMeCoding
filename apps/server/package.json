  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/agents/prompts && cp src/agents/prompts/*.xml dist/agents/prompts/",
